# ---- LLM backend --------------------------------------------------------
# One of: anthropic | openai | ollama
CAREAGENT_LLM_BACKEND=anthropic
CAREAGENT_ANTHROPIC_MODEL=claude-opus-5-5
CAREAGENT_OPENAI_MODEL=gpt-5
CAREAGENT_OLLAMA_MODEL=llama3.3
CAREAGENT_OLLAMA_BASE_URL=http://localhost:11434/v1

# Provider credentials (never commit real keys)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Agent behaviour ----------------------------------------------------
CAREAGENT_EFFORT=medium            # low | medium | high (Anthropic effort level)
CAREAGENT_STRICT_GROUNDING=true    # refuse unsupported claims instead of returning them
CAREAGENT_ESCALATION_THRESHOLD=0.6 # grounding score below which we hand off to a human

# ---- Retrieval ----------------------------------------------------------
CAREAGENT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CAREAGENT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CAREAGENT_TOP_K=8
CAREAGENT_RERANK_TOP_N=4

# ---- Tracking / Databricks ---------------------------------------------
# Leave empty for a local ./mlruns store; set to "databricks" to log to a workspace.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=/Shared/careagent
DATABRICKS_HOST=
DATABRICKS_TOKEN=
CAREAGENT_DELTA_TABLE=main.careagent.eval_results

# ---- Cost accounting ----------------------------------------------------
CAREAGENT_USD_TO_EUR=0.92
